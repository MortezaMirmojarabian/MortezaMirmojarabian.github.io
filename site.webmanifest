---
---
{
  "name": {{ site.title | jsonify }},
  "short_name": {{ site.short_name | default: site.title | jsonify }},
  "description": {{ site.description | strip_newlines | jsonify }},
  "start_url": "/",
  "display": "standalone",
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "icons": [
    { "src": "/assets/img/192x192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/assets/img/512x512.png", "sizes": "512x512", "type": "image/png" }
  ]
}
