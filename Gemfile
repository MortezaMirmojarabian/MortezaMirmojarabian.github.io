source "https://rubygems.org"

# GitHub Pages builds the site with Jekyll 3.9.x, and this source works
# with both 3.9 and 4.x locally.
gem "jekyll", "~> 3.9"

# Blog pagination (whitelisted on GitHub Pages).
gem "jekyll-paginate", "~> 1.1"

# GFM markdown input (tables, etc.) — matches GitHub Pages' kramdown settings.
gem "kramdown-parser-gfm"

# jekyll serve needs this on Ruby 3.0 and newer.
gem "webrick"

# Ruby 3.4 removed these from the default gem set. Jekyll 3.x needs them
# when you build locally on Ruby 3.4+. (GitHub Pages provides them itself.)
gem "base64"
gem "bigdecimal"
gem "csv"
gem "rexml"
